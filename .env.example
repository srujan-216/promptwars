# MedLens environment variables.
# Copy to .env.local and fill in. NEVER commit real values.
# lib/env.ts mirrors this file exactly — if you add a var here, add it there.

# ---------------------------------------------------------------------------
# Always safe. Each has a default, so the app builds without any .env at all.
# ---------------------------------------------------------------------------

# Node's own mode. Set automatically by next/vitest; rarely set by hand.
# Optional. One of: development | test | production. Default: development
NODE_ENV=development

# Which deployment this process believes it is.
# Optional. One of: local | ci | production. Default: local
APP_ENV=local

# Port the server binds to.
# Optional. Integer 1-65535. Default: 3000
PORT=3000

# Log verbosity.
# Optional. One of: debug | info | warn | error. Default: info
LOG_LEVEL=info

# Commit SHA, baked in at build time so /api/health reports a real version.
# Optional. Min 7 chars. Absent locally, where /api/health reports commit: null.
# GIT_SHA=

# ---------------------------------------------------------------------------
# Server-only secret. REQUIRED for any AI feature.
# ---------------------------------------------------------------------------

# Google Gemini API key. Server-only: never referenced from a client component,
# never logged, never sent to the browser.
#
# Required at runtime by anything that calls the model. Validated lazily by
# getServerEnv() in lib/env.ts rather than at import, so `pnpm build` and CI —
# which have no key and make no model calls — still pass. Absent means the AI
# path throws immediately; it never falls back to a placeholder key.
GEMINI_API_KEY=
